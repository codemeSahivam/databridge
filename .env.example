# Copy to .env (never commit .env). Use READ-ONLY service identities everywhere.

# ---------- Guardrails ----------
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=120
# Comma-separated fnmatch patterns on db.schema.table (lower-case). Also matched against the bare table name.
BLOCKED_TABLE_PATTERNS=*.pii.*,*.hr.*,*salar*
AUDIT_LOG_PATH=audit.log.jsonl

# ---------- Snowflake ----------
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SVC_CLAUDE_READONLY
SNOWFLAKE_ROLE=CLAUDE_READONLY
SNOWFLAKE_WAREHOUSE=ANALYTICS_XS_WH
SNOWFLAKE_DATABASE=PROD
SNOWFLAKE_SCHEMA=SALES
# Service user (recommended): key-pair auth
SNOWFLAKE_PRIVATE_KEY_FILE=/secure/path/claude_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# OR per-person SSO instead of a key:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# ---------- Databricks ----------
DATABRICKS_HOST=myworkspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123def456
DATABRICKS_CATALOG=main
# Service principal (recommended): OAuth M2M
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# OR a personal access token:
# DATABRICKS_TOKEN=dapi...

# ---------- QuickSight ----------
AWS_ACCOUNT_ID=123456789012
QUICKSIGHT_REGION=us-east-1
# Uses the normal AWS credential chain (SSO profile, env vars, instance role)
AWS_PROFILE=claude-quicksight
# Only these dashboards can be created/updated by Claude
QS_EDITABLE_PREFIXES=claude-
QS_EDITABLE_DASHBOARD_IDS=
# Owner of dashboards Claude creates (user or group ARN)
QS_OWNER_ARN=arn:aws:quicksight:us-east-1:123456789012:group/default/bi-authors
